{
  "name": "wedding_front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install --include=dev --include=optional",
    "predev": "node scripts/check-dependencies.cjs --dev --install",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/check-dependencies.cjs --dev",
    "build": "next build",
    "prestart": "node scripts/check-dependencies.cjs",
    "start": "next start -p 3000",
    "lint": "eslint",
    "test:basic": "node --test tests/basic-invitation.test.cjs",
    "test:basic:integration": "node --test tests/basic-studio.integration.test.cjs",
    "test:standard": "node --test tests/standard-invitation.test.cjs tests/standard-studio.integration.test.cjs",
    "test:free": "node --test tests/free-invitation.test.cjs",
    "test:free:integration": "node --test tests/free-studio.integration.test.cjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "framer-motion": "^13.5.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
