# Existing paid invitation API (optional for Free Studio)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Development defaults to SQLite at .data/free-studio.db.
# For a remote libSQL database, set both values below in the hosting environment.
# FREE_DATABASE_URL=libsql://your-database.example
# FREE_DATABASE_AUTH_TOKEN=your-server-only-token

# On a single production Node server with a persistent disk, explicitly opt in:
# FREE_DATABASE_URL=file:/absolute/persistent/path/free-studio.db
# FREE_ALLOW_LOCAL_DATABASE=true
